PORT=8080

DB_HOST=localhost
DB_USER=
DB_PASS=
DB_NAME=

# Mesmo valor do Rapidex (.env): WHATS_WEBHOOK_TOKEN ou CRON_TOKEN
WHATS_WEBHOOK_TOKEN=

# Webhook de mensagens ao vivo
WHATS_WEBHOOK_URL=https://rapidex.app.br/api/whatsapp/inbound.php

# Webhook de historico (default: troca inbound.php por history.php)
WHATS_HISTORY_WEBHOOK_URL=https://rapidex.app.br/api/whatsapp/history.php

# Importa historico automaticamente ao conectar (recomendado: true)
WHATS_SYNC_FULL_HISTORY=true

# Tamanho do lote enviado ao Rapidex (10-100)
WHATS_HISTORY_BATCH_SIZE=80

# Timeout do sync manual em ms (15000-180000)
WHATS_HISTORY_SYNC_TIMEOUT_MS=90000

# Token opcional para proteger endpoints (mesmo valor no Rapidex: BAILEYS_API_TOKEN)
# BAILEYS_API_TOKEN=

# Origens permitidas no CORS (separadas por virgula)
CORS_ORIGINS=https://rapidex.app.br,https://painel.rapidex.app.br

# Opcional: encaminhar copia para um grupo WhatsApp (JID completo)
# WHATS_FORWARD_GROUP=120363419125287667@g.us

SESSION_DIR=./sessions
